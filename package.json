{
  "name": "hpyno",
  "version": "2.0.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && eslint . && vitest run && npm run pipeline:test",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "pipeline:test": "PYTHONPATH=pipeline .venv/bin/python -m unittest discover -s pipeline/tests",
    "pipeline": "PYTHONPATH=pipeline .venv/bin/python -m hpyno_pipeline"
  },
  "license": "UNLICENSED",
  "description": "Immersive 3D hypnosis experiences",
  "dependencies": {
    "three": "^0.183.2",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.1",
    "@types/three": "^0.183.1",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  },
  "private": true
}
